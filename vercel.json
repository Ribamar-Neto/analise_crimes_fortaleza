{
    "version": 2,
    "builds": [
        {
            "src": "index.html",
            "use": "@vercel/static"
        },
        {
            "src": "mapas/*.html",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/",
            "dest": "/index.html"
        },
        {
            "src": "/mapas/(?<mapa>[^/]+)",
            "dest": "/mapas/$mapa.html"
        },
        {
            "src": "/(.*)",
            "dest": "/$1.html"
        }
    ]
}